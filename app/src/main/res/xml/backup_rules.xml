<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower backup rules. Core library data remains portable; transient and share artifacts do not. -->
<full-backup-content>
    <exclude domain="cache" path="." />
    <exclude domain="no_backup" path="." />
    <exclude domain="file" path="share/" />
    <exclude domain="file" path="tmp/" />
</full-backup-content>
