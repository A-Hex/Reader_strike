<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher backup rules. Do not migrate transient or share artifacts. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="cache" path="." />
        <exclude domain="no_backup" path="." />
        <exclude domain="file" path="share/" />
        <exclude domain="file" path="tmp/" />
        <!-- On-device LLM bundles are large, machine-specific and always re-installable. -->
        <exclude domain="file" path="models/" />
        <exclude domain="external" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="cache" path="." />
        <exclude domain="no_backup" path="." />
        <exclude domain="file" path="share/" />
        <exclude domain="file" path="tmp/" />
        <exclude domain="file" path="models/" />
        <exclude domain="external" path="models/" />
    </device-transfer>
</data-extraction-rules>
