        android:strokeColor="#FBCFE8"
        android:fillColor="#00000000"/>

    <path
        android:pathData="M150,70 C200,70 238,115 238,180 C238,245 200,290 150,290 C100,290 62,245 62,180 C62,115 100,70 150,70 Z"
        android:strokeWidth="1"
        android:strokeColor="#F472B6"
        android:fillColor="#00000000"/>

    <!-- Regency Silhouette / Feather Quill / Botanical Rose -->
    <path
        android:pathData="M150,130 C130,130 120,150 120,170 C120,195 145,215 150,220 C155,215 180,195 180,170 C180,150 170,130 150,130 Z"
        android:fillColor="#FDF2F8"/>

    <!-- Feather Quill -->
    <path
        android:pathData="M185,115 Q165,150 135,210 L130,225 L140,215 Q170,155 190,120 Z"
        android:fillColor="#FCE7F3"/>

